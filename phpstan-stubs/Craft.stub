<?php

/**
 * PHPStan model for Craft CMS's global Craft facade.
 *
 * Craft exposes its Yii application through this global facade at runtime,
 * but the facade is not available to PHPStan in a plugin package context.
 */
class Craft
{
    /** @var mixed */
    public static $app;

    /** @param mixed ...$arguments */
    public static function t(...$arguments): mixed
    {
        return null;
    }

    /** @param mixed ...$arguments */
    public static function error(...$arguments): void
    {
    }

    /** @param mixed ...$arguments */
    public static function warning(...$arguments): void
    {
    }

    /** @param mixed ...$arguments */
    public static function info(...$arguments): void
    {
    }

    /** @param mixed ...$arguments */
    public static function getAlias(...$arguments): mixed
    {
        return null;
    }

    /** @param mixed ...$arguments */
    public static function createGuzzleClient(...$arguments): mixed
    {
        return null;
    }
}
