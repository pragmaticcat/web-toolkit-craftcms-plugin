{
  "name": "pragmatic/web-toolkit-craftcms-plugin",
  "description": "Unified Pragmatic Web Toolkit for Craft CMS",
  "type": "craft-plugin",
  "license": "MIT",
  "require": {
    "php": "^8.5",
    "craftcms/cms": "^6.0.0-beta.1"
  },
  "autoload": {
    "psr-4": {
      "pragmatic\\webtoolkit\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "pragmatic\\webtoolkit\\tests\\": "tests/"
    }
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "phpstan/phpstan": "^2.1"
  },
  "scripts": {
    "analyse": "phpstan analyse --configuration=phpstan.neon --no-progress"
  },
  "config": {
    "allow-plugins": {
      "craftcms/plugin-installer": true
    }
  },
  "authors": [
    {
      "name": "Oriol Noya",
      "email": "oriolnoya@pragmatic.cat"
    }
  ],
  "support": {
    "email": "oriolnoya@pragmatic.cat"
  },
  "archive": {
    "exclude": [
      "/tmp-*"
    ]
  },
  "extra": {
    "handle": "pragmatic-web-toolkit",
    "class": "pragmatic\\webtoolkit\\PragmaticWebToolkit",
    "name": "Pragmatic Web Toolkit",
    "developer": "Pragmatic",
    "developerUrl": "https://www.pragmatic.cat",
    "hasSettings": false,
    "hasCpSection": true
  },
  "minimum-stability": "dev",
  "prefer-stable": true
}
