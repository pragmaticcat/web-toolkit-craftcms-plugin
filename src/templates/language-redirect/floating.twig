{% extends 'pragmatic-web-toolkit/language-redirect/_layout' %}
{% import '_includes/forms' as forms %}

{% set title = 'Language Redirect Floating Button' %}
{% set selectedTab = 'floating' %}

{% set crumbs = [
  { label: 'Language Redirect', url: url('pragmatic-toolkit/language-redirect', { site: selectedSite.handle }) },
  { label: 'Floating button', url: url('pragmatic-toolkit/language-redirect/floating', { site: selectedSite.handle }) },
] %}

{% block content %}
  {% css %}
    .language-redirect-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 18px;
    }
    .language-redirect-block {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 14px;
      background: #fff;
    }
    .language-redirect-block h3 {
      margin: 0 0 4px;
      font-size: 15px;
    }
    .language-redirect-block > p {
      margin: 0 0 14px;
    }
    .language-redirect-help {
      margin-top: -8px;
      margin-bottom: 14px;
      color: #606d7b;
      font-size: 12px;
    }
    .language-redirect-help summary {
      cursor: pointer;
      user-select: none;
      font-weight: 600;
    }
    .language-redirect-help p {
      margin: 6px 0 0;
      line-height: 1.45;
    }
    @media (max-width: 1023px) {
      .language-redirect-grid {
        grid-template-columns: 1fr;
      }
    }
  {% endcss %}

  <form method="post" accept-charset="UTF-8">
    {{ csrfInput() }}
    {{ actionInput('pragmatic-web-toolkit/language-redirect/save-floating') }}
    {{ redirectInput('pragmatic-toolkit/language-redirect/floating', { site: selectedSite.handle }) }}

    <div class="language-redirect-grid">
      <section class="language-redirect-block">
        <h3>Launcher</h3>
        <p class="light">Show a frontend language switcher without having to code a custom dropdown in the theme.</p>

        {{ forms.lightswitchField({
          label: 'Show floating button',
          id: 'showFloatingButton',
          name: 'settings[showFloatingButton]',
          on: settings.showFloatingButton ?? false,
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Renders a floating launcher on the frontend that opens a small panel with the available site languages.</p>
        </details>

        {{ forms.textField({
          label: 'Button label',
          id: 'floatingButtonLabel',
          name: 'settings[floatingButtonLabel]',
          value: settings.floatingButtonLabel ?? '',
          placeholder: 'Language',
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Optional text shown on button styles that support labels. If left empty, only the icon or current code is shown.</p>
        </details>

        {{ forms.selectField({
          label: 'Button style',
          id: 'floatingButtonStyle',
          name: 'settings[floatingButtonStyle]',
          value: settings.floatingButtonStyle ?? 'pill',
          options: [
            { label: 'Icon only', value: 'icon' },
            { label: 'Only text', value: 'text' },
            { label: 'Pill with text', value: 'pill' },
          ],
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Choose between a compact round icon, a text-only launcher, or a wider pill with icon and text.</p>
        </details>

        {{ forms.selectField({
          label: 'Button position',
          id: 'floatingButtonPosition',
          name: 'settings[floatingButtonPosition]',
          value: settings.floatingButtonPosition ?? 'bottom-right',
          options: [
            { label: 'Bottom right', value: 'bottom-right' },
            { label: 'Bottom left', value: 'bottom-left' },
            { label: 'Top right', value: 'top-right' },
            { label: 'Top left', value: 'top-left' },
          ],
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Controls which corner of the screen the floating switcher sticks to.</p>
        </details>
      </section>

      <section class="language-redirect-block">
        <h3>Popup content</h3>
        <p class="light">Choose what information the language list should show and where it should appear.</p>

        {{ forms.selectField({
          label: 'Label format',
          id: 'floatingLabelDisplay',
          name: 'settings[floatingLabelDisplay]',
          value: settings.floatingLabelDisplay ?? 'site-names-and-language-codes',
          options: [
            { label: 'Only site names', value: 'site-names' },
            { label: 'Only language codes', value: 'language-codes' },
            { label: 'Site names and language codes', value: 'site-names-and-language-codes' },
          ],
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Choose whether the popup shows only the site name, only the language code, or both pieces of information.</p>
        </details>

        {{ forms.lightswitchField({
          label: 'Show on desktop',
          id: 'floatingShowOnDesktop',
          name: 'settings[floatingShowOnDesktop]',
          on: settings.floatingShowOnDesktop ?? true,
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Keeps the floating switcher visible on larger screens.</p>
        </details>

        {{ forms.lightswitchField({
          label: 'Show on mobile',
          id: 'floatingShowOnMobile',
          name: 'settings[floatingShowOnMobile]',
          on: settings.floatingShowOnMobile ?? true,
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Lets you keep or hide the floating switcher on phones and small tablets.</p>
        </details>
      </section>

      <section class="language-redirect-block">
        <h3>Colors</h3>
        <p class="light">Adjust text and accent colors for the launcher and the popup. The launcher and popup backgrounds stay white for reliable contrast.</p>

        {{ forms.colorField({
          label: 'Button text',
          id: 'floatingButtonTextColor',
          name: 'settings[floatingButtonTextColor]',
          value: settings.floatingButtonTextColor ?? '#111827',
        }) }}

        {{ forms.colorField({
          label: 'Panel text',
          id: 'floatingPanelTextColor',
          name: 'settings[floatingPanelTextColor]',
          value: settings.floatingPanelTextColor ?? '#111827',
        }) }}

        {{ forms.colorField({
          label: 'Accent color',
          id: 'floatingAccentColor',
          name: 'settings[floatingAccentColor]',
          value: settings.floatingAccentColor ?? '#2563eb',
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>The accent color drives the icon, the hover state, and the highlight for the current site.</p>
        </details>
      </section>
    </div>

    <div class="buttons">
      <button type="submit" class="btn submit">Save</button>
    </div>
  </form>
{% endblock %}
