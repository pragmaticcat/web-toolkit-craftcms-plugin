{% extends 'pragmatic-web-toolkit/language-redirect/_layout' %}
{% import '_includes/forms' as forms %}

{% set title = 'Language Redirect Options' %}
{% set selectedTab = 'options' %}

{% set crumbs = [
  { label: 'Language Redirect', url: url('pragmatic-toolkit/language-redirect', { site: selectedSite.handle }) },
  { label: 'Options', url: url('pragmatic-toolkit/language-redirect/options', { site: selectedSite.handle }) },
] %}

{% set patterns = settings.excludePathPatterns ?? [] %}
{% if patterns|length == 0 %}
  {% set patterns = ['^admin', '^actions', '^cpresources', '^api', '^feed', '^sitemap'] %}
{% endif %}

{% block content %}
  {% css %}
    .language-redirect-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-bottom: 18px;
    }
    .language-redirect-block {
      border: 1px solid #e5e7eb;
      border-radius: 8px;
      padding: 14px;
      background: #fff;
    }
    .language-redirect-block h3 {
      margin: 0 0 4px;
      font-size: 15px;
    }
    .language-redirect-block > p {
      margin: 0 0 14px;
    }
    .language-redirect-help {
      margin-top: -8px;
      margin-bottom: 14px;
      color: #606d7b;
      font-size: 12px;
    }
    .language-redirect-help summary {
      cursor: pointer;
      user-select: none;
      font-weight: 600;
    }
    .language-redirect-help p {
      margin: 6px 0 0;
      line-height: 1.45;
    }
    .language-redirect-pattern-table th,
    .language-redirect-pattern-table td {
      padding: 6px 8px;
      vertical-align: middle;
    }
    .language-redirect-pattern-remove {
      white-space: nowrap;
    }
    @media (max-width: 1023px) {
      .language-redirect-grid {
        grid-template-columns: 1fr;
      }
    }
  {% endcss %}

  <form method="post" accept-charset="UTF-8">
    {{ csrfInput() }}
    {{ actionInput('pragmatic-web-toolkit/language-redirect/save-options') }}
    {{ redirectInput('pragmatic-toolkit/language-redirect/options', { site: selectedSite.handle }) }}

    <div class="language-redirect-grid">
      <section class="language-redirect-block">
        <h3>Manual preference</h3>
        <p class="light">Configure how the frontend stores a manual language switch before the automatic redirect runs again.</p>

        {{ forms.textField({
          label: 'Query param name',
          id: 'persistQueryParam',
          name: 'settings[persistQueryParam]',
          required: true,
          value: settings.persistQueryParam ?? 'lang',
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>When the visitor lands on a URL like <code>?{{ settings.persistQueryParam ?? 'lang' }}=ca</code>, the plugin stores that language in the preference cookie and redirects to the equivalent site URL.</p>
        </details>

        <input type="hidden" name="settings[redirectStatusCode]" value="302">
      </section>

      <section class="language-redirect-block">
        <h3>Floating button</h3>
        <p class="light">Show a frontend language switcher without having to code a custom dropdown in the theme.</p>

        {{ forms.lightswitchField({
          label: 'Show floating button',
          id: 'showFloatingButton',
          name: 'settings[showFloatingButton]',
          on: settings.showFloatingButton ?? false,
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Renders a floating launcher on the frontend that opens a small panel with the available site languages.</p>
        </details>

        {{ forms.textField({
          label: 'Button label',
          id: 'floatingButtonLabel',
          name: 'settings[floatingButtonLabel]',
          value: settings.floatingButtonLabel ?? 'Language',
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Used next to the current language on button styles that show text.</p>
        </details>

        {{ forms.selectField({
          label: 'Button style',
          id: 'floatingButtonStyle',
          name: 'settings[floatingButtonStyle]',
          value: settings.floatingButtonStyle ?? 'pill',
          options: [
            { label: 'Icon only', value: 'icon' },
            { label: 'Pill with text', value: 'pill' },
          ],
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Choose between a compact round icon or a wider pill that shows the current language more explicitly.</p>
        </details>

        {{ forms.selectField({
          label: 'Button position',
          id: 'floatingButtonPosition',
          name: 'settings[floatingButtonPosition]',
          value: settings.floatingButtonPosition ?? 'bottom-right',
          options: [
            { label: 'Bottom right', value: 'bottom-right' },
            { label: 'Bottom left', value: 'bottom-left' },
            { label: 'Top right', value: 'top-right' },
            { label: 'Top left', value: 'top-left' },
          ],
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Controls which corner of the screen the floating switcher sticks to.</p>
        </details>
      </section>

      <section class="language-redirect-block">
        <h3>Floating button behavior</h3>
        <p class="light">Fine tune when the switcher appears and how much context it shows to visitors.</p>

        {{ forms.lightswitchField({
          label: 'Show current language',
          id: 'floatingShowCurrentLanguage',
          name: 'settings[floatingShowCurrentLanguage]',
          on: settings.floatingShowCurrentLanguage ?? true,
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Displays the active language in the launcher so the visitor can see the current choice at a glance.</p>
        </details>

        {{ forms.lightswitchField({
          label: 'Show language codes',
          id: 'floatingShowLanguageCodes',
          name: 'settings[floatingShowLanguageCodes]',
          on: settings.floatingShowLanguageCodes ?? true,
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Adds codes like <code>EN</code>, <code>CA</code> or <code>ES</code> next to each language in the panel.</p>
        </details>

        {{ forms.lightswitchField({
          label: 'Show on desktop',
          id: 'floatingShowOnDesktop',
          name: 'settings[floatingShowOnDesktop]',
          on: settings.floatingShowOnDesktop ?? true,
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Keeps the floating switcher visible on larger screens.</p>
        </details>

        {{ forms.lightswitchField({
          label: 'Show on mobile',
          id: 'floatingShowOnMobile',
          name: 'settings[floatingShowOnMobile]',
          on: settings.floatingShowOnMobile ?? true,
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Lets you keep or hide the floating switcher on phones and small tablets.</p>
        </details>
      </section>

      <section class="language-redirect-block">
        <h3>Floating button colors</h3>
        <p class="light">Adapt the launcher and the dropdown panel to the visual identity of each site.</p>

        {{ forms.colorField({
          label: 'Button background',
          id: 'floatingButtonBackgroundColor',
          name: 'settings[floatingButtonBackgroundColor]',
          value: settings.floatingButtonBackgroundColor ?? '#111827',
        }) }}

        {{ forms.colorField({
          label: 'Button text',
          id: 'floatingButtonTextColor',
          name: 'settings[floatingButtonTextColor]',
          value: settings.floatingButtonTextColor ?? '#ffffff',
        }) }}

        {{ forms.colorField({
          label: 'Panel background',
          id: 'floatingPanelBackgroundColor',
          name: 'settings[floatingPanelBackgroundColor]',
          value: settings.floatingPanelBackgroundColor ?? '#ffffff',
        }) }}

        {{ forms.colorField({
          label: 'Panel text',
          id: 'floatingPanelTextColor',
          name: 'settings[floatingPanelTextColor]',
          value: settings.floatingPanelTextColor ?? '#111827',
        }) }}

        {{ forms.colorField({
          label: 'Accent color',
          id: 'floatingAccentColor',
          name: 'settings[floatingAccentColor]',
          value: settings.floatingAccentColor ?? '#2563eb',
        }) }}
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>The accent color highlights the current site and hover state inside the language list.</p>
        </details>
      </section>

      <section class="language-redirect-block">
        <h3>Excluded paths</h3>
        <p class="light">Regular expressions checked against the request path. Matching requests skip the redirect and the floating button entirely.</p>

        <table class="data fullwidth language-redirect-pattern-table" id="exclude-pattern-table" style="margin-top: 8px;">
          <thead>
            <tr>
              <th>Pattern</th>
              <th style="width: 90px;">Action</th>
            </tr>
          </thead>
          <tbody>
            {% for pattern in patterns %}
              <tr>
                <td>
                  <input class="text fullwidth" type="text" name="settings[excludePathPatterns][{{ loop.index0 }}]" value="{{ pattern }}" placeholder="^api">
                </td>
                <td class="language-redirect-pattern-remove">
                  <button class="btn small js-pattern-remove" type="button">Remove</button>
                </td>
              </tr>
            {% endfor %}
          </tbody>
        </table>

        <div class="buttons" style="margin-top: 10px;">
          <button class="btn" type="button" id="exclude-pattern-add">Add pattern</button>
        </div>
        <details class="language-redirect-help">
          <summary>What does this do?</summary>
          <p>Useful for APIs, feeds, sitemaps, checkout paths, or any route where a floating language switcher would be noisy.</p>
        </details>
      </section>
    </div>

    <div class="buttons">
      <button type="submit" class="btn submit">Save</button>
    </div>
  </form>

  {% js %}
    (function() {
      const table = document.getElementById('exclude-pattern-table');
      const addButton = document.getElementById('exclude-pattern-add');

      if (!table || !addButton) {
        return;
      }

      function reindexRows() {
        const rows = Array.from(table.querySelectorAll('tbody tr'));
        rows.forEach(function(row, index) {
          row.querySelectorAll('input[name]').forEach(function(input) {
            input.name = 'settings[excludePathPatterns][' + index + ']';
          });
        });
      }

      table.addEventListener('click', function(event) {
        const removeButton = event.target.closest('.js-pattern-remove');
        if (!removeButton) return;

        const row = removeButton.closest('tr');
        if (!row) return;
        row.remove();

        if (!table.querySelector('tbody tr')) {
          const body = table.querySelector('tbody');
          const newRow = document.createElement('tr');
          newRow.innerHTML =
            '<td><input class="text fullwidth" type="text" name="settings[excludePathPatterns][0]" placeholder="^api"></td>' +
            '<td class="language-redirect-pattern-remove"><button class="btn small js-pattern-remove" type="button">Remove</button></td>';
          body.appendChild(newRow);
        }

        reindexRows();
      });

      addButton.addEventListener('click', function() {
        const body = table.querySelector('tbody');
        const index = body.querySelectorAll('tr').length;
        const row = document.createElement('tr');
        row.innerHTML =
          '<td><input class="text fullwidth" type="text" name="settings[excludePathPatterns][' + index + ']" placeholder="^private"></td>' +
          '<td class="language-redirect-pattern-remove"><button class="btn small js-pattern-remove" type="button">Remove</button></td>';
        body.appendChild(row);
      });
    })();
  {% endjs %}
{% endblock %}
