{% set buttonLabel = (settings.floatingButtonLabel ?? '')|trim %}
{% set buttonStyle = settings.floatingButtonStyle ?? 'pill' %}
{% set buttonPosition = settings.floatingButtonPosition ?? 'bottom-right' %}
{% set currentCode = currentLink and currentLink.language is defined ? currentLink.language|upper : '' %}
{% set labelDisplay = settings.floatingLabelDisplay ?? 'site-names-and-language-codes' %}
{% set showSiteNames = labelDisplay in ['site-names', 'site-names-and-language-codes'] %}
{% set showLanguageCodes = labelDisplay in ['language-codes', 'site-names-and-language-codes'] %}
{% set showOnDesktop = settings.floatingShowOnDesktop ?? true %}
{% set showOnMobile = settings.floatingShowOnMobile ?? true %}
{% set launcherIcon = '<svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M12 2a10 10 0 1 0 10 10A10 10 0 0 0 12 2Zm6.93 9h-3.08a15.72 15.72 0 0 0-1.18-5A8.03 8.03 0 0 1 18.93 11ZM12 4.06A13.74 13.74 0 0 1 13.82 11h-3.64A13.74 13.74 0 0 1 12 4.06ZM4.06 13h3.08a15.72 15.72 0 0 0 1.18 5A8.03 8.03 0 0 1 4.06 13Zm3.08-2H4.06a8.03 8.03 0 0 1 4.26-5 15.72 15.72 0 0 0-1.18 5Zm4.86 8.94A13.74 13.74 0 0 1 10.18 13h3.64A13.74 13.74 0 0 1 12 19.94ZM14.22 11h-4.44A11.7 11.7 0 0 1 12 4.83 11.7 11.7 0 0 1 14.22 11Zm-4.44 2h4.44A11.7 11.7 0 0 1 12 19.17 11.7 11.7 0 0 1 9.78 13Zm4.89 5a15.72 15.72 0 0 0 1.18-5h3.08a8.03 8.03 0 0 1-4.26 5Z"/></svg>' %}
{% set textParts = [] %}
{% if buttonLabel %}
  {% set textParts = textParts|merge([buttonLabel]) %}
{% endif %}
{% if currentCode %}
  {% set textParts = textParts|merge([currentCode]) %}
{% endif %}
{% set textContent = textParts|join(' · ') %}
{% set launcherText = buttonStyle == 'icon'
  ? '<span class="pwt-language-switcher__icon">' ~ launcherIcon ~ '</span>'
  : (buttonStyle == 'text'
    ? (textContent ? '<span>' ~ textContent ~ '</span>' : '<span>' ~ currentCode ~ '</span>')
    : '<span class="pwt-language-switcher__icon">' ~ launcherIcon ~ '</span>' ~ (textContent ? '<span>' ~ textContent ~ '</span>' : '')
  )
%}

<div
  class="pwt-language-switcher pwt-language-switcher--{{ buttonPosition }} pwt-language-switcher--{{ buttonStyle }}{% if not showOnDesktop %} pwt-language-switcher--hide-desktop{% endif %}{% if not showOnMobile %} pwt-language-switcher--hide-mobile{% endif %}"
  style="
    --pwt-lang-btn-bg: #ffffff;
    --pwt-lang-btn-text: {{ settings.floatingButtonTextColor ?? '#111827' }};
    --pwt-lang-panel-bg: #ffffff;
    --pwt-lang-panel-text: {{ settings.floatingPanelTextColor ?? '#111827' }};
    --pwt-lang-accent: {{ settings.floatingAccentColor ?? '#2563eb' }};
  "
>
  <details class="pwt-language-switcher__details">
    <summary class="pwt-language-switcher__button" aria-label="{{ buttonLabel }}">
      <span class="pwt-language-switcher__buttonText">{{ launcherText|raw }}</span>
    </summary>

    <div class="pwt-language-switcher__panel">
      <ul class="pwt-language-switcher__list">
        {% for item in links %}
          <li>
            <a
              href="{{ item.url }}"
              hreflang="{{ item.language }}"
              class="pwt-language-switcher__link{% if item.isCurrent %} is-current{% endif %}"
              {% if item.isCurrent %}aria-current="page"{% endif %}
            >
              {% if showSiteNames or showLanguageCodes %}
                <span class="pwt-language-switcher__labels">
                  {% if showSiteNames %}
                    <span class="pwt-language-switcher__siteName">{{ item.site.name }}</span>
                  {% endif %}
                  {% if showLanguageCodes %}
                    <small class="pwt-language-switcher__code">{{ item.language|upper }}</small>
                  {% endif %}
                </span>
              {% else %}
                <span class="pwt-language-switcher__siteName">{{ item.site.name }}</span>
              {% endif %}
            </a>
          </li>
        {% endfor %}
      </ul>
    </div>
  </details>
</div>

<style>
  .pwt-language-switcher {
    position: fixed;
    z-index: 9998;
    font-family: inherit;
  }
  .pwt-language-switcher--bottom-right {
    right: 20px;
    bottom: 20px;
  }
  .pwt-language-switcher--bottom-left {
    left: 20px;
    bottom: 20px;
  }
  .pwt-language-switcher--top-right {
    right: 20px;
    top: 20px;
  }
  .pwt-language-switcher--top-left {
    left: 20px;
    top: 20px;
  }
  .pwt-language-switcher__details {
    position: relative;
  }
  .pwt-language-switcher__details[open] .pwt-language-switcher__button {
    box-shadow: 0 20px 40px rgba(15, 23, 42, 0.24);
  }
  .pwt-language-switcher__button {
    list-style: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 52px;
    padding: 0 18px;
    border-radius: 999px;
    background: var(--pwt-lang-btn-bg);
    color: var(--pwt-lang-btn-text);
    border: 1px solid rgba(15, 23, 42, 0.08);
    cursor: pointer;
    box-shadow: 0 14px 34px rgba(15, 23, 42, 0.18);
    isolation: isolate;
    user-select: none;
    transition: transform 140ms ease, box-shadow 140ms ease;
  }
  .pwt-language-switcher__button::-webkit-details-marker {
    display: none;
  }
  .pwt-language-switcher__button:hover {
    transform: translateY(-1px);
    box-shadow: 0 18px 38px rgba(15, 23, 42, 0.24);
  }
  .pwt-language-switcher__icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--pwt-lang-accent);
    line-height: 1;
  }
  .pwt-language-switcher__icon svg {
    width: 1.15em;
    height: 1.15em;
    display: block;
  }
  .pwt-language-switcher--icon .pwt-language-switcher__button {
    width: 52px;
    min-width: 52px;
    padding: 0;
    font-size: 22px;
  }
  .pwt-language-switcher--text .pwt-language-switcher__button {
    padding: 0 16px;
  }
  .pwt-language-switcher__buttonText {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
  }
  .pwt-language-switcher__panel {
    position: absolute;
    width: max-content;
    min-width: 0;
    max-width: min(92vw, 420px);
    border: 1px solid color-mix(in srgb, var(--pwt-lang-accent) 18%, #d1d5db);
    border-radius: 18px;
    background: var(--pwt-lang-panel-bg);
    background-color: #ffffff;
    color: var(--pwt-lang-panel-text);
    box-shadow: 0 24px 64px rgba(15, 23, 42, 0.22);
    isolation: isolate;
    overflow: hidden;
  }
  .pwt-language-switcher--bottom-left .pwt-language-switcher__panel,
  .pwt-language-switcher--top-left .pwt-language-switcher__panel {
    left: 0;
  }
  .pwt-language-switcher--bottom-right .pwt-language-switcher__panel,
  .pwt-language-switcher--top-right .pwt-language-switcher__panel {
    right: 0;
  }
  .pwt-language-switcher--top-left .pwt-language-switcher__panel,
  .pwt-language-switcher--top-right .pwt-language-switcher__panel {
    top: calc(100% + 12px);
  }
  .pwt-language-switcher--bottom-left .pwt-language-switcher__panel,
  .pwt-language-switcher--bottom-right .pwt-language-switcher__panel {
    bottom: calc(100% + 12px);
  }
  .pwt-language-switcher__list {
    list-style: none;
    margin: 0;
    padding: 8px;
  }
  .pwt-language-switcher__list li + li {
    margin-top: 2px;
  }
  .pwt-language-switcher__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 10px 12px;
    border-radius: 12px;
    color: inherit;
    text-decoration: none;
    transition: background 140ms ease, color 140ms ease;
  }
  .pwt-language-switcher__link:hover,
  .pwt-language-switcher__link:focus-visible,
  .pwt-language-switcher__link.is-current {
    background: color-mix(in srgb, var(--pwt-lang-accent) 12%, transparent);
    color: var(--pwt-lang-accent);
    outline: none;
  }
  .pwt-language-switcher__link.is-current {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--pwt-lang-accent) 35%, transparent);
  }
  .pwt-language-switcher__link small {
    font-size: 11px;
    letter-spacing: 0.08em;
    opacity: 0.8;
  }
  .pwt-language-switcher__labels {
    display: inline-flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .pwt-language-switcher__siteName {
    font-weight: 500;
  }
  .pwt-language-switcher__code {
    font-weight: 600;
  }
  .pwt-language-switcher__link.is-current .pwt-language-switcher__siteName,
  .pwt-language-switcher__link.is-current .pwt-language-switcher__code {
    font-weight: 700;
  }
  @media (max-width: 767px) {
    .pwt-language-switcher--hide-mobile {
      display: none;
    }
  }
  @media (min-width: 768px) {
    .pwt-language-switcher--hide-desktop {
      display: none;
    }
  }
</style>

<script>
  (function() {
    var roots = document.querySelectorAll('.pwt-language-switcher');
    var root = roots.length ? roots[roots.length - 1] : null;
    if (!root) {
      return;
    }

    var details = root.querySelector('.pwt-language-switcher__details');
    if (!details) {
      return;
    }

    document.addEventListener('click', function(event) {
      if (!details.hasAttribute('open')) {
        return;
      }
      if (root.contains(event.target)) {
        return;
      }
      details.removeAttribute('open');
    });
  })();
</script>
