{% import '_includes/forms' as forms %}

{% set sectionName = sectionName ?? '' %}
{% set sectionValues = sectionValues ?? { title: '', description: '', imageId: null, imageFieldHandle: '' } %}
{% set titleFieldId = field.handle ~ '-title' %}
{% set descriptionFieldId = field.handle ~ '-description' %}

{% css %}
  .seo-entry-help {
    margin-top: -8px;
    margin-bottom: 14px;
    color: #606d7b;
    font-size: 12px;
  }
  .seo-entry-help summary {
    cursor: pointer;
    user-select: none;
    font-weight: 600;
  }
  .seo-entry-help p {
    margin: 6px 0 0;
    line-height: 1.45;
  }
  .seo-entry-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }
  .seo-entry-block {
    border: 1px solid #e5e7eb;
    border-radius: 8px;
    padding: 14px;
    background: #fff;
  }
  .seo-entry-block h3 {
    margin: 0 0 4px;
    font-size: 15px;
  }
  .seo-entry-block > p {
    margin: 0 0 14px;
  }
  .seo-section-copy-row { display:flex; align-items:center; gap:8px; margin:-8px 0 14px; }
  .seo-section-copy-row .btn { padding:3px 7px; min-height:auto; font-size:11px; }
  .seo-section-copy-status { color:#606d7b; font-size:12px; }
  @media (max-width: 1023px) {
    .seo-entry-grid {
      grid-template-columns: 1fr;
    }
  }
{% endcss %}

<div class="seo-entry-grid">
  <section class="seo-entry-block">
    <h3>Contenido SEO</h3>
    <p class="light">Define los valores SEO propios de esta entry.</p>

      {{ forms.textField({
        label: 'Title',
        id: titleFieldId,
        name: field.handle ~ '[title]',
        value: value.title,
        translatable: true,
        instructions: 'Puedes usar variables Twig, por ejemplo: {{ entry.title }} - Terapeuta Gestalt a {{ entry.municipis.one().title }}'
      }) }}
      <div class="seo-section-copy-row">
        <span class="status {{ value.title|trim == sectionValues.title ? 'green' : 'orange' }}"></span>
        <span class="seo-section-copy-status">{{ value.title|trim == sectionValues.title ? 'Igual que la section' : 'Diferente de la section' }}</span>
        <button type="button" class="btn js-copy-section-value" data-target="{{ titleFieldId }}" data-value="{{ sectionValues.title|e('html_attr') }}">Copiar el de la section</button>
      </div>
      <details class="seo-entry-help">
        <summary>¿Qué hace este valor?</summary>
        <p>Define el título SEO específico de esta entry. Si lo dejas vacío, se usará el valor de la section y, si tampoco existe, el título propio de la entry.</p>
      </details>

      {{ forms.textareaField({
        label: 'Description',
        id: descriptionFieldId,
        name: field.handle ~ '[description]',
        value: value.description,
        rows: 3,
        translatable: true,
        instructions: 'Puedes usar variables Twig del entry actual para generar descripciones dinámicas.'
      }) }}
      <div class="seo-section-copy-row">
        <span class="status {{ value.description|trim == sectionValues.description ? 'green' : 'orange' }}"></span>
        <span class="seo-section-copy-status">{{ value.description|trim == sectionValues.description ? 'Igual que la section' : 'Diferente de la section' }}</span>
        <button type="button" class="btn js-copy-section-value" data-target="{{ descriptionFieldId }}" data-value="{{ sectionValues.description|e('html_attr') }}">Copiar el de la section</button>
      </div>
      <details class="seo-entry-help">
        <summary>¿Qué hace este valor?</summary>
        <p>Descripción SEO específica de esta entry. Si queda vacía, se usará la descripción de la section y, si tampoco existe, la global del site.</p>
      </details>

      {{ forms.elementSelectField({
        label: 'Image',
        id: field.handle ~ '-image',
        name: field.handle ~ '[imageId][]',
        elementType: 'craft\\elements\\Asset',
        elements: imageElement ? [imageElement] : [],
        limit: 1,
        sources: '*',
        criteria: { kind: 'image' },
        translatable: true,
      }) }}
      <div class="seo-section-copy-row">
        {{ hiddenInput(field.handle ~ '[imageId][]', '', { disabled: true, class: 'js-section-copy-image-name' }) }}
        <span class="status {{ value.imageId == sectionValues.imageId ? 'green' : 'orange' }}"></span>
        <span class="seo-section-copy-status">{{ value.imageId == sectionValues.imageId ? 'Igual que la section' : 'Diferente de la section' }}</span>
        <button type="button" class="btn js-copy-section-image" data-target="{{ field.handle }}-image">Copiar el de la section</button>
      </div>
      <details class="seo-entry-help">
        <summary>¿Qué hace este valor?</summary>
        <p>Define una imagen SEO específica para esta entry. Si no eliges ninguna, se usará la imagen de la section y, si tampoco existe, la global del site.</p>
      </details>

      {{ forms.selectField({
        label: 'Dynamic image field',
        id: field.handle ~ '-image-field-handle',
        name: field.handle ~ '[imageFieldHandle]',
        value: value.imageFieldHandle,
        options: assetFieldOptions,
        instructions: 'Usa el primer asset de un campo de la propia entry cuando no haya una imagen seleccionada.'
      }) }}
      <div class="seo-section-copy-row">
        <span class="status {{ value.imageFieldHandle|trim == sectionValues.imageFieldHandle ? 'green' : 'orange' }}"></span>
        <span class="seo-section-copy-status">{{ value.imageFieldHandle|trim == sectionValues.imageFieldHandle ? 'Igual que la section' : 'Diferente de la section' }}</span>
        <button type="button" class="btn js-copy-section-value" data-target="{{ field.handle }}-image-field-handle" data-value="{{ sectionValues.imageFieldHandle|e('html_attr') }}">Copiar el de la section</button>
      </div>
  </section>

  <section class="seo-entry-block">
    <h3>Sitemap</h3>
    <p class="light">Control de visibilidad de esta entry dentro del sitemap XML.</p>

    {{ forms.lightswitchField({
      label: 'Visible in sitemap',
      name: field.handle ~ '[sitemapEnabled]',
      on: value.sitemapEnabled is same as(false) ? false : true,
      value: 1
    }) }}
    <details class="seo-entry-help">
      <summary>¿Qué hace este valor?</summary>
      <p>Indica si esta entry debe incluirse en el sitemap XML del sitio.</p>
    </details>

    {{ forms.lightswitchField({
      label: 'Include images',
      name: field.handle ~ '[sitemapIncludeImages]',
      on: value.sitemapIncludeImages is same as(false) ? false : true,
      value: 1
    }) }}
    <details class="seo-entry-help">
      <summary>¿Qué hace este valor?</summary>
      <p>Incluye imágenes relacionadas en el sitemap para enriquecer la indexación visual. <a href="https://developers.google.com/search/docs/crawling-indexing/sitemaps/image-sitemaps" target="_blank" rel="noopener">Saber más</a></p>
    </details>
  </section>
</div>
{% js %}
  (() => {
    document.querySelectorAll('.js-copy-section-value').forEach((button) => {
      button.addEventListener('click', () => {
        const targetId = button.dataset.target || '';
        const input = button.closest('.seo-entry-block')?.querySelector('#' + CSS.escape(targetId) + ', [id$="-' + CSS.escape(targetId) + '"]');
        if (!input) return;
        input.value = button.dataset.value || '';
        input.dispatchEvent(new Event('input', { bubbles: true }));
        input.dispatchEvent(new Event('change', { bubbles: true }));
        const row = button.closest('.seo-section-copy-row');
        row?.querySelector('.status')?.classList.replace('orange', 'green');
        const statusText = row?.querySelector('.seo-section-copy-status');
        if (statusText) statusText.textContent = 'Igual que la section';
      });
    });

    const imageButton = document.querySelector('.js-copy-section-image[data-target={{ (field.handle ~ '-image')|json_encode|raw }}]');
    imageButton?.addEventListener('click', () => {
      const targetId = imageButton.dataset.target || '';
      const container = imageButton.closest('.seo-entry-block')?.querySelector('#' + CSS.escape(targetId) + ', [id$="-' + CSS.escape(targetId) + '"]');
      if (!container) return;
      const inputName = imageButton.closest('.seo-section-copy-row')?.querySelector('.js-section-copy-image-name')?.name || '';
      const imageId = {{ sectionValues.imageId|default(null)|json_encode|raw }};
      const elements = container.querySelector('.elements');
      if (!elements) return;
      elements.innerHTML = '';
      container.querySelectorAll('input[type="hidden"][name="' + CSS.escape(inputName) + '"]').forEach((input) => input.remove());
      if (imageId) {
        const input = document.createElement('input');
        input.type = 'hidden';
        input.name = inputName;
        input.value = imageId;
        container.appendChild(input);
        elements.innerHTML = '<div class="element small"><span class="label"><span class="title">' + {{ (sectionImageElement ? sectionImageElement.title : '')|json_encode|raw }} + '</span></span></div>';
      }
      container.dispatchEvent(new Event('change', { bubbles: true }));
      const row = imageButton.closest('.seo-section-copy-row');
      row?.querySelector('.status')?.classList.replace('orange', 'green');
      const statusText = row?.querySelector('.seo-section-copy-status');
      if (statusText) statusText.textContent = 'Igual que la section';
    });
  })();
{% endjs %}
