{% set rootId = 'pwt-chatbot-' ~ random() %}
{% set modeClass = mode == 'embed' ? 'pwt-chatbot--embed' : 'pwt-chatbot--popup' %}
{% set primary = config.theme.primaryColor ?? '#0f766e' %}
{% set background = config.theme.backgroundColor ?? '#ffffff' %}
{% set text = config.theme.textColor ?? '#0f172a' %}
{% set panelPosition = config.theme.panelPosition ?? 'right' %}
{% set borderRadius = config.theme.borderRadius ?? 18 %}

<div
  id="{{ rootId }}"
  class="pwt-chatbot-root {{ modeClass }}"
  data-chatbot-mode="{{ mode }}"
  data-chatbot-config="{{ config|json_encode|e('html_attr') }}"
  style="--pwt-chatbot-primary: {{ primary }}; --pwt-chatbot-bg: {{ background }}; --pwt-chatbot-text: {{ text }}; --pwt-chatbot-radius: {{ borderRadius }}px;"
>
  {% if mode != 'embed' %}
    <button type="button" class="pwt-chatbot-launcher" data-chatbot-launcher aria-expanded="false" aria-controls="{{ rootId }}-panel">
      <span>{{ config.launcherLabel }}</span>
    </button>
  {% endif %}

  <section class="pwt-chatbot-panel pwt-chatbot-panel--{{ panelPosition }}" id="{{ rootId }}-panel" role="dialog" aria-modal="{{ mode == 'embed' ? 'false' : 'true' }}" aria-hidden="{{ mode == 'embed' ? 'false' : 'true' }}">
    <header class="pwt-chatbot-header">
      <div>
        <strong>{{ config.popupTitle }}</strong>
        <p>{{ config.disclaimerText }}</p>
      </div>
      {% if mode != 'embed' %}
        <button type="button" class="pwt-chatbot-close" data-chatbot-close aria-label="Close chatbot">&times;</button>
      {% endif %}
    </header>

    <div class="pwt-chatbot-body">
      <div class="pwt-chatbot-messages" data-chatbot-messages></div>
      <div class="pwt-chatbot-prompts" data-chatbot-prompts></div>
    </div>

    <form class="pwt-chatbot-form" data-chatbot-form>
      <label class="visually-hidden" for="{{ rootId }}-input">{{ config.placeholderText }}</label>
      <input id="{{ rootId }}-input" type="text" class="pwt-chatbot-input" placeholder="{{ config.placeholderText }}" autocomplete="off">
      <button type="submit" class="pwt-chatbot-submit">Send</button>
    </form>
  </section>
</div>

<style>
  .visually-hidden { position:absolute !important; width:1px; height:1px; padding:0; margin:-1px; overflow:hidden; clip:rect(0, 0, 0, 0); white-space:nowrap; border:0; }
  .pwt-chatbot-root { position: relative; font-family: "Helvetica Neue", Arial, sans-serif; color: var(--pwt-chatbot-text); }
  .pwt-chatbot-launcher { position: fixed; right: 24px; bottom: 24px; z-index: 9998; border: 0; background: var(--pwt-chatbot-primary); color: #fff; border-radius: 999px; padding: 14px 18px; box-shadow: 0 12px 30px rgba(15, 118, 110, 0.22); cursor: pointer; font-weight: 600; }
  .pwt-chatbot-panel { width: min(420px, calc(100vw - 32px)); background: var(--pwt-chatbot-bg); color: var(--pwt-chatbot-text); border-radius: var(--pwt-chatbot-radius); box-shadow: 0 24px 60px rgba(15, 23, 42, 0.18); border: 1px solid rgba(148, 163, 184, 0.25); overflow: hidden; }
  .pwt-chatbot--popup .pwt-chatbot-panel { position: fixed; bottom: 88px; right: 24px; z-index: 9999; display: none; }
  .pwt-chatbot--popup .pwt-chatbot-panel--left { left: 24px; right: auto; }
  .pwt-chatbot--embed .pwt-chatbot-panel { position: relative; display: block; width: 100%; min-height: 560px; }
  .pwt-chatbot-root.is-open .pwt-chatbot-panel { display: block; }
  .pwt-chatbot-header { display:flex; align-items:flex-start; justify-content:space-between; gap:12px; padding:18px 18px 14px; background: linear-gradient(135deg, rgba(15, 118, 110, 0.14) 0%, var(--pwt-chatbot-bg) 100%); }
  .pwt-chatbot-header strong { display:block; font-size: 16px; margin-bottom: 4px; }
  .pwt-chatbot-header p { margin:0; font-size: 12px; color: rgba(15, 23, 42, 0.72); }
  .pwt-chatbot-close { border:0; background:transparent; font-size:26px; line-height:1; cursor:pointer; color: var(--pwt-chatbot-text); }
  .pwt-chatbot-body { display:flex; flex-direction:column; min-height: 380px; max-height: 56vh; }
  .pwt-chatbot-messages { flex:1; overflow:auto; padding: 16px 18px; background: linear-gradient(180deg, rgba(248, 250, 252, 0.9) 0%, rgba(255,255,255,0.98) 100%); }
  .pwt-chatbot-message { margin-bottom: 14px; display:flex; }
  .pwt-chatbot-message--assistant { justify-content:flex-start; }
  .pwt-chatbot-message--user { justify-content:flex-end; }
  .pwt-chatbot-bubble { max-width: 85%; border-radius: 16px; padding: 12px 14px; font-size: 14px; line-height: 1.45; }
  .pwt-chatbot-message--assistant .pwt-chatbot-bubble { background:#f1f5f9; color:#0f172a; }
  .pwt-chatbot-message--user .pwt-chatbot-bubble { background: var(--pwt-chatbot-primary); color:#fff; }
  .pwt-chatbot-links, .pwt-chatbot-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }
  .pwt-chatbot-link, .pwt-chatbot-action, .pwt-chatbot-prompt { display:inline-flex; align-items:center; border:1px solid rgba(15, 118, 110, 0.18); background:#fff; color: var(--pwt-chatbot-primary); text-decoration:none; border-radius:999px; padding: 8px 12px; font-size: 12px; cursor:pointer; }
  .pwt-chatbot-prompts { padding: 0 18px 12px; display:flex; flex-wrap:wrap; gap:8px; }
  .pwt-chatbot-form { display:flex; align-items:center; gap:10px; padding: 14px 18px 18px; border-top:1px solid rgba(148, 163, 184, 0.18); background:#fff; }
  .pwt-chatbot-input { flex:1; border:1px solid rgba(148, 163, 184, 0.3); border-radius: 999px; padding: 12px 14px; font-size:14px; }
  .pwt-chatbot-submit { border:0; background: var(--pwt-chatbot-primary); color:#fff; border-radius:999px; padding: 11px 16px; cursor:pointer; font-weight:600; }
  .pwt-chatbot-citations { margin-top:8px; font-size: 11px; color: rgba(15, 23, 42, 0.65); }
  .pwt-chatbot-root.is-loading .pwt-chatbot-submit { opacity:.7; pointer-events:none; }
  @media (max-width: 767px) {
    .pwt-chatbot-launcher { right: 16px; bottom: 16px; }
    .pwt-chatbot--popup .pwt-chatbot-panel,
    .pwt-chatbot--popup .pwt-chatbot-panel--left { right: 16px; left: 16px; width: auto; bottom: 78px; }
    .pwt-chatbot-body { max-height: none; min-height: 320px; }
  }
</style>

<script>
  (function () {
    if (!window.__pwtChatbotBootstrap) {
      window.__pwtChatbotBootstrap = function (root) {
        if (!root || root.dataset.chatbotBootstrapped === 'true') {
          return;
        }
        root.dataset.chatbotBootstrapped = 'true';

        function text(value) {
          return String(value == null ? '' : value);
        }

        function createNode(tag, className, content) {
          var node = document.createElement(tag);
          if (className) node.className = className;
          if (content != null) node.textContent = content;
          return node;
        }

        function getPageContext() {
          var selectors = [];
          document.querySelectorAll('main h2[id], main h3[id], [data-chatbot-anchor]').forEach(function (el) {
            var label = text(el.textContent).trim();
            var selector = el.id ? ('#' + el.id) : text(el.getAttribute('data-chatbot-anchor'));
            if (label && selector) selectors.push({ label: label, selector: selector });
          });

          var ctaLinks = [];
          document.querySelectorAll('a[href].btn, a[href][data-chatbot-cta], .buttons a[href]').forEach(function (el) {
            var label = text(el.textContent).trim();
            var url = text(el.href).trim();
            if (label && url) ctaLinks.push({ label: label, url: url });
          });

          return {
            url: window.location.href,
            title: document.title,
            selectors: selectors.slice(0, 6),
            ctaLinks: ctaLinks.slice(0, 6)
          };
        }

        function postJson(url, payload, csrf) {
          var body = payload || {};
          if (csrf && csrf.param && csrf.token) {
            body[csrf.param] = csrf.token;
          }

          return fetch(url, {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(body)
          }).then(function (response) {
            return response.json();
          });
        }

        var config = JSON.parse(root.getAttribute('data-chatbot-config') || '{}');
        var launcher = root.querySelector('[data-chatbot-launcher]');
        var panel = root.querySelector('.pwt-chatbot-panel');
        var closeButton = root.querySelector('[data-chatbot-close]');
        var form = root.querySelector('[data-chatbot-form]');
        var input = root.querySelector('.pwt-chatbot-input');
        var messages = root.querySelector('[data-chatbot-messages]');
        var prompts = root.querySelector('[data-chatbot-prompts]');
        var state = { id: null, started: false };
        var lastFocus = null;

        function open() {
          if (launcher) {
            launcher.setAttribute('aria-expanded', 'true');
          }
          root.classList.add('is-open');
          panel.setAttribute('aria-hidden', 'false');
          lastFocus = document.activeElement;
          input.focus();
          ensureSession();
        }

        function close() {
          root.classList.remove('is-open');
          panel.setAttribute('aria-hidden', 'true');
          if (launcher) {
            launcher.setAttribute('aria-expanded', 'false');
            launcher.focus();
          } else if (lastFocus && typeof lastFocus.focus === 'function') {
            lastFocus.focus();
          }
        }

        function appendMessage(role, message, payload) {
          var wrapper = createNode('div', 'pwt-chatbot-message pwt-chatbot-message--' + role);
          var bubble = createNode('div', 'pwt-chatbot-bubble');
          bubble.textContent = message;
          wrapper.appendChild(bubble);

          if (payload && payload.suggestedLinks && payload.suggestedLinks.length) {
            var links = createNode('div', 'pwt-chatbot-links');
            payload.suggestedLinks.forEach(function (item) {
              var a = createNode('a', 'pwt-chatbot-link', item.title || item.url);
              a.href = item.url;
              a.target = '_self';
              links.appendChild(a);
            });
            bubble.appendChild(links);
          }

          if (payload && payload.suggestedActions && payload.suggestedActions.length) {
            var actions = createNode('div', 'pwt-chatbot-actions');
            payload.suggestedActions.forEach(function (item) {
              var button = createNode('button', 'pwt-chatbot-action', item.label || 'Continue');
              button.type = 'button';
              button.addEventListener('click', function () {
                executeAction(item);
              });
              actions.appendChild(button);
            });
            bubble.appendChild(actions);
          }

          if (payload && payload.citations && payload.citations.length) {
            var citations = createNode('div', 'pwt-chatbot-citations');
            citations.textContent = 'Based on: ' + payload.citations.map(function (item) {
              return item.title || item.url;
            }).join(', ');
            bubble.appendChild(citations);
          }

          messages.appendChild(wrapper);
          messages.scrollTop = messages.scrollHeight;
        }

        function setPrompts(items) {
          prompts.innerHTML = '';
          (items || []).forEach(function (item) {
            var button = createNode('button', 'pwt-chatbot-prompt', item);
            button.type = 'button';
            button.addEventListener('click', function () {
              input.value = item;
              submitMessage(item);
            });
            prompts.appendChild(button);
          });
        }

        function ensureSession() {
          if (state.started) return Promise.resolve(state);
          state.started = true;
          root.classList.add('is-loading');
          return postJson(config.endpoints.session, { pageContext: getPageContext() }, config.csrf)
            .then(function (payload) {
              state.id = payload.conversationState && payload.conversationState.id ? payload.conversationState.id : null;
              if (payload.message) appendMessage('assistant', payload.message, payload);
              setPrompts(config.emptyStatePrompts || []);
              root.classList.remove('is-loading');
              return payload;
            })
            .catch(function () {
              root.classList.remove('is-loading');
            });
        }

        function submitMessage(message) {
          var value = text(message || input.value).trim();
          if (!value) return;
          appendMessage('user', value);
          input.value = '';
          root.classList.add('is-loading');

          ensureSession().then(function () {
            return postJson(config.endpoints.message, {
              conversationId: state.id,
              message: value,
              pageContext: getPageContext()
            }, config.csrf);
          }).then(function (payload) {
            root.classList.remove('is-loading');
            if (payload && payload.message) {
              appendMessage('assistant', payload.message, payload);
            }
          }).catch(function () {
            root.classList.remove('is-loading');
            appendMessage('assistant', 'I had trouble answering right now. Please try again in a moment.');
          });
        }

        function executeAction(action) {
          if (!action || !action.type) return;

          if (action.type === 'open_url' && action.url) {
            window.location.href = action.url;
            return;
          }

          if ((action.type === 'scroll_to_selector' || action.type === 'highlight_selector') && action.selector) {
            var target = document.querySelector(action.selector);
            if (target) {
              target.scrollIntoView({ behavior: 'smooth', block: 'start' });
              if (action.type === 'highlight_selector') {
                var oldOutline = target.style.outline;
                target.style.outline = '3px solid ' + (config.theme.primaryColor || '#0f766e');
                setTimeout(function () {
                  target.style.outline = oldOutline;
                }, 1800);
              }
            }
            return;
          }

          if (action.type === 'open_cta' && action.url) {
            window.location.href = action.url;
            return;
          }

          if (action.type === 'show_suggestions' && Array.isArray(action.payload)) {
            setPrompts(action.payload);
          }
        }

        if (launcher) launcher.addEventListener('click', open);
        if (closeButton) closeButton.addEventListener('click', close);
        if (form) {
          form.addEventListener('submit', function (event) {
            event.preventDefault();
            submitMessage();
          });
        }

        root.addEventListener('keydown', function (event) {
          if (event.key === 'Escape' && root.classList.contains('is-open') && config.mode !== 'embed') {
            close();
          }
        });

        if (config.mode === 'embed') {
          root.classList.add('is-open');
          panel.setAttribute('aria-hidden', 'false');
          ensureSession();
        } else if (config.autoOpen) {
          open();
        }
      };
    }

    document.querySelectorAll('.pwt-chatbot-root').forEach(window.__pwtChatbotBootstrap);
  })();
</script>
