{% extends 'pragmatic-web-toolkit/redirects/_layout' %}
{% set selectedTab = '404s' %}
{% block content %}
<div class="toolbar"><div class="flex-grow"></div><a class="btn" href="{{ actionUrl('pragmatic-web-toolkit/redirects/export-404s') }}">Export CSV</a></div>
<form method="get" class="flex"><input type="search" name="q" placeholder="Search paths and referrers"><select name="siteId"><option value="">All sites</option>{% for site in sites %}<option value="{{ site.id }}">{{ site.name }}</option>{% endfor %}</select><select name="handled"><option value="">Any status</option><option value="0">Unhandled</option><option value="1">Handled</option></select><button class="btn">Filter</button></form>
<table class="data fullwidth"><thead><tr><th>Path</th><th>Hits</th><th>Site</th><th>Last seen</th><th>Referrer</th><th>Handled</th><th></th></tr></thead><tbody>{% for row in rows %}<tr><td>{{ row.path }}</td><td>{{ row.hitCount }}</td><td>{{ row.siteId ? craft.app.sites.getSiteById(row.siteId).name : '—' }}</td><td>{{ row.lastSeenAt|datetime }}</td><td>{{ row.referrer }}</td><td>{{ row.handled ? 'Yes' : 'No' }}</td><td><a class="btn small" href="{{ url('pragmatic-toolkit/redirects/new', {source: row.path, siteId: row.siteId}) }}">Create redirect</a>{% if not row.handled %}<form method="post" class="inline">{{ csrfInput() }}{{ actionInput('pragmatic-web-toolkit/redirects/handled') }}{{ redirectInput('pragmatic-toolkit/redirects/404s') }}{{ hiddenInput('id', row.id) }}<button class="btn small">Mark handled</button></form>{% endif %}</td></tr>{% else %}<tr><td colspan="7">No 404s recorded.</td></tr>{% endfor %}</tbody></table>
{% endblock %}
