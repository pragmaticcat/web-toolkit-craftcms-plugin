{% extends 'pragmatic-web-toolkit/redirects/_layout' %}
{% set selectedTab = 'rules' %}
{% block content %}
<div class="toolbar"><div class="flex-grow"></div><a class="btn submit" href="{{ url('pragmatic-toolkit/redirects/new') }}">New redirect</a></div>
<form method="get" class="flex flex-wrap">
  <input type="search" name="q" value="{{ craft.app.request.getQueryParam('q') }}" placeholder="Search source, destination, notes">
  <select name="siteId"><option value="">All sites</option>{% for site in sites %}<option value="{{ site.id }}" {{ craft.app.request.getQueryParam('siteId') == site.id ? 'selected' }}>{{ site.name }}</option>{% endfor %}</select>
  <select name="enabled"><option value="">Any status</option><option value="1">Enabled</option><option value="0">Disabled</option></select>
  <select name="statusCode"><option value="">Any response code</option><option value="301">301</option><option value="302">302</option><option value="307">307</option><option value="410">410</option></select>
  <select name="matchType"><option value="">Any match type</option><option>exact</option><option>pattern</option><option>regex</option></select><button class="btn">Filter</button>
</form>
<table class="data fullwidth"><thead><tr><th>{{ 'templates.redirects.rules.source'|t('pragmatic-web-toolkit') }}</th><th>{{ 'templates.redirects.rules.matchType'|t('pragmatic-web-toolkit') }}</th><th>{{ 'templates.redirects.rules.destination'|t('pragmatic-web-toolkit') }}</th><th>Code</th><th>{{ 'templates.redirects.rules.hits'|t('pragmatic-web-toolkit') }}</th><th>Site</th><th>{{ 'templates.redirects.rules.status'|t('pragmatic-web-toolkit') }}</th><th></th></tr></thead><tbody>
{% for rule in rules %}<tr><td><a href="{{ url('pragmatic-toolkit/redirects/' ~ rule.id) }}">{{ rule.sourceUri }}</a></td><td>{{ rule.matchType }}</td><td>{{ rule.destinationElementId ? 'Element #' ~ rule.destinationElementId : rule.destination }}</td><td>{{ rule.statusCode }}</td><td>{{ rule.hitCount }}</td><td>{{ rule.siteId ? craft.app.sites.getSiteById(rule.siteId).name : 'All sites' }}</td><td>{{ rule.enabled ? 'Enabled' : 'Disabled' }}</td><td class="nowrap"><form method="post">{{ csrfInput() }}{{ actionInput('pragmatic-web-toolkit/redirects/toggle') }}{{ redirectInput('pragmatic-toolkit/redirects') }}{{ hiddenInput('id', rule.id) }}{{ hiddenInput('enabled', rule.enabled ? 0 : 1) }}<button class="btn small">{{ rule.enabled ? 'Disable' : 'Enable' }}</button></form> <form method="post">{{ csrfInput() }}{{ actionInput('pragmatic-web-toolkit/redirects/delete') }}{{ hiddenInput('id', rule.id) }}<button class="btn small" data-confirm="Delete this redirect?">Delete</button></form></td></tr>{% else %}<tr><td colspan="8">No redirects found.</td></tr>{% endfor %}
</tbody></table>
<hr><h2>Test a URL</h2><form method="post">{{ csrfInput() }}{{ actionInput('pragmatic-web-toolkit/redirects/test') }}<div class="flex"><input name="path" value="{{ testPath ?? '' }}" placeholder="/legacy/path?tracking=1" required><select name="siteId"><option value="">Current site</option>{% for site in sites %}<option value="{{ site.id }}">{{ site.name }}</option>{% endfor %}</select><button class="btn">Test</button></div></form>
{% if testResult is defined and testResult %}{% set matchedRule = testResult.chain|first %}<p>Matched <strong>{{ matchedRule.sourceUri }}</strong> → {% if testResult.statusCode == 410 %}Gone{% else %}<a href="{{ testResult.finalDestination }}">{{ testResult.finalDestination }}</a>{% endif %} ({{ testResult.statusCode }})</p>{% elseif testPath is defined %}<p>No rule matches this URL.</p>{% endif %}
{% endblock %}
