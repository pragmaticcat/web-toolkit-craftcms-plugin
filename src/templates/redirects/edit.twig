{% extends 'pragmatic-web-toolkit/redirects/_layout' %}
{% set selectedTab = 'rules' %}
{% set title = rule.id ? 'Edit redirect' : 'New redirect' %}
{% block content %}
<form method="post" accept-charset="UTF-8">{{ csrfInput() }}{{ actionInput('pragmatic-web-toolkit/redirects/save') }}{{ redirectInput('pragmatic-toolkit/redirects') }}{{ hiddenInput('rule[id]', rule.id ?? '') }}
<div class="flex"><label class="field flex-grow"><span class="heading">{{ 'templates.redirects.rules.source'|t('pragmatic-web-toolkit') }}</span><input class="text fullwidth" name="rule[sourceUri]" value="{{ rule.sourceUri ?? craft.app.request.getQueryParam('source') ?? '' }}" required></label>
<label class="field"><span class="heading">{{ 'templates.redirects.rules.matchType'|t('pragmatic-web-toolkit') }}</span><select name="rule[matchType]"><option value="exact" {{ (rule.matchType ?? 'exact') == 'exact' ? 'selected' }}>Exact</option><option value="pattern" {{ (rule.matchType ?? '') == 'pattern' ? 'selected' }}>Pattern</option><option value="regex" {{ (rule.matchType ?? '') == 'regex' ? 'selected' }}>Regex</option></select></label></div>
<p class="light">Pattern tokens use angle brackets, such as news/&lt;slug&gt;. Regex destinations can use $1 captures.</p>
<div class="flex"><label class="field flex-grow"><span class="heading">{{ 'templates.redirects.rules.destination'|t('pragmatic-web-toolkit') }}</span><input class="text fullwidth" name="rule[destination]" value="{{ rule.destination ?? '' }}" placeholder="/new/path or https://example.com"></label><label class="field"><span class="heading">Status</span><select name="rule[statusCode]">{% for code in [301,302,307,410] %}<option value="{{ code }}" {{ (rule.statusCode ?? 301) == code ? 'selected' }}>{{ code }}</option>{% endfor %}</select></label></div>
<div class="flex"><label class="field"><span class="heading">Site</span><select name="rule[siteId]"><option value="">All sites</option>{% for site in sites %}<option value="{{ site.id }}" {{ (rule.siteId ?? '') == site.id ? 'selected' }}>{{ site.name }}</option>{% endfor %}</select></label><label class="field"><span class="heading">Destination element ID</span><input class="text" type="number" name="rule[destinationElementId]" value="{{ rule.destinationElementId ?? '' }}"></label></div>
{{ hiddenInput('rule[enabled]', '0') }}<label class="field"><input type="checkbox" name="rule[enabled]" value="1" {{ (rule.enabled ?? true) ? 'checked' }}> Enabled</label>{{ hiddenInput('rule[preserveQueryString]', '0') }}<label class="field"><input type="checkbox" name="rule[preserveQueryString]" value="1" {{ (rule.preserveQueryString ?? true) ? 'checked' }}> Preserve query string</label>
<label class="field"><span class="heading">Notes</span><textarea class="text fullwidth" name="rule[notes]">{{ rule.notes ?? '' }}</textarea></label><button class="btn submit">Save redirect</button></form>
{% endblock %}
