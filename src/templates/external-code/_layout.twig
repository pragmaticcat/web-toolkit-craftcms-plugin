{% extends parentLayout|default('_layouts/cp') %}
{% set title = title ?? 'External Code' %}
{% set selectedSubnavItem = 'externalCode' %}
{% set _siteHandle = selectedSite is defined and selectedSite ? selectedSite.handle : craft.app.request.getQueryParam('site') %}
{% set _tabParams = _siteHandle ? { site: _siteHandle } : {} %}
{% set crumbs = crumbs ?? [{ label: 'External Code', url: url('pragmatic-toolkit/external-code', _tabParams) }] %}
{% set _editableSites = craft.app.sites.getEditableSites() %}
{% if _editableSites|length > 1 %}
  {% set _selectedSite = selectedSite ?? craft.app.sites.getPrimarySite() %}
  {% set _siteMenuItems = siteMenuItems(_editableSites, _selectedSite) %}
  {% set crumbs = crumbs|unshift({
    id: 'site-crumb', icon: 'world', iconAltText: 'Site'|t('app'),
    label: _selectedSite.name|t('site'),
    menu: { items: _siteMenuItems, label: 'Select site'|t('app') }
  }) %}
{% endif %}
{% css %}
  .pwt-code-intro { display:flex; align-items:center; justify-content:space-between; gap:16px; margin-bottom:20px; }
  .pwt-code-intro p { margin:0; }
  .pwt-code-sections { display:grid; gap:20px; }
  .pwt-code-section { margin:0; }
  .pwt-code-section h2 { margin:0 0 4px; }
  .pwt-code-section > p { margin:0 0 14px; }
  .pwt-code-card { display:flex; align-items:center; gap:16px; padding:14px 0; border-top:1px solid var(--hairline-color, #e5e7eb); }
  .pwt-code-card.pwt-dragging { opacity:.55; }
  .pwt-code-card.pwt-drop-target { background:var(--gray-050, #f8fafc); box-shadow:inset 0 2px #2563eb; }
  .pwt-code-handle { cursor:grab; border:1px solid #d1d5db; border-radius:5px; background:#fff; padding:5px 9px; color:#64748b; font-weight:700; }
  .pwt-code-main { flex:1; min-width:0; }
  .pwt-code-main h2 { margin:0 0 5px; font-size:16px; }
  .pwt-code-main p { margin:0; }
  .pwt-code-actions { display:flex; align-items:center; gap:8px; flex-wrap:wrap; }
  .pwt-code-actions form { margin:0; }
  @media(max-width:760px) { .pwt-code-card { flex-wrap:wrap; } .pwt-code-actions { width:100%; } }
{% endcss %}
{% block content %}{% endblock %}
